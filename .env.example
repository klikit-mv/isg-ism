# Scout Management System (Next.js + MySQL)

NODE_ENV=production
# Public address of the site.
APP_URL=https://scouts.example.org

# Generate: openssl rand -base64 32   (keep it secret; never change it after launch:
# it protects stored secrets such as the Telegram token and Google keys)
APP_KEY=base64:CHANGE_ME

# MySQL (use DATABASE_URL or the four DB_* values)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# DATABASE_URL=mysql://user:password@localhost:3306/database

# Email alerts (optional). Same names as the old portal.
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Scout Management System"

SESSION_DAYS=30
BCRYPT_ROUNDS=12

# Where uploads (photos, payment proofs, certificates) are kept. Must survive deploys.
STORAGE_DIR=./storage-data

SCOUT_NAME="Ifthithaah Scout Group"
SCOUT_SHORT_NAME="Scout Management System"
SCOUT_ORG="Ifthithaah Scout Group"
SCOUT_TIMEZONE=Indian/Maldives
SCOUT_CURRENCY=MVR
SCOUT_CURRENCY_SYMBOL=MVR
SCOUT_DEFAULT_CLASS_FEE=50.00
SCOUT_PROOF_MAX_KB=10240
SCOUT_SHOP_IMAGE_MAX_KB=5120

# Only while trying the site over plain http (no https yet). Leave unset on the live site.
# SESSION_SECURE_COOKIE=false

# First administrator, created on the first start when the database has none.
# Sign in, change the PIN under Profile, then delete SCOUT_ADMIN_PIN from the environment.
SCOUT_ADMIN_NATIONAL_ID=
SCOUT_ADMIN_NAME="Administrator"
SCOUT_ADMIN_PIN=
